generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model Report {
  id            Int          @id @default(autoincrement())
  title         String       // 예: 2026년 4월 결산보고
  totalIncome   Int          @default(0) @map("total_income")
  totalExpense  Int          @default(0) @map("total_expense")
  totalBalance  Int          @default(0) @map("total_balance")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")
  
  items         ReportItem[]

  @@map("reports")
}

model ReportItem {
  id          Int      @id @default(autoincrement())
  reportId    Int      @map("report_id")
  type        ItemType // 'INCOME' 또는 'EXPENSE'
  month       String   // 예: "2026-04"
  description String
  amount      Int      @default(0)

  report      Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@map("report_items")
}

enum ItemType {
  INCOME
  EXPENSE
}
